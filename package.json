{
  "name": "detection.studio",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run build:wasm && vite",
    "build:lib": "bun run --cwd packages/pysigma-node build",
    "prepare": "bun run build:lib",
    "build": "vite-ssg build",
    "preview": "vite preview",
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "test:headed": "playwright test --headed",
    "test:unit": "vitest run",
    "test:wasm": "cd rsigma-wasm && cargo test",
    "build:wasm": "cd rsigma-wasm && wasm-pack build --target web --release --out-dir ../src/lib/rsigma-wasm/pkg",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt ."
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@northsh/pysigma-node": "workspace:*",
    "@pinia/colada": "^1.4.8",
    "@radix-icons/vue": "^1.0.0",
    "@sentry/vite-plugin": "^11.8.0",
    "@sentry/vue": "^11.8.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/vue-table": "^9.3.1",
    "@tanstack/vue-virtual": "^3.13.47",
    "@unhead/vue": "^3.4.3",
    "@vueuse/core": "^15.0.0",
    "@vueuse/integrations": "^15.0.0",
    "change-case": "^5.4.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "flexsearch": "^0.8.212",
    "fs-extra": "^11.4.1",
    "fuse.js": "^7.5.0",
    "isomorphic-git": "^1.44.3",
    "js-yaml": "^5.5.0",
    "jszip": "^3.10.2",
    "lucide-vue-next": "^1.0.0",
    "minimatch": "^10.2.6",
    "pinia": "^4.1.0",
    "pinia-plugin-persistedstate": "^4.7.1",
    "pinia-undo": "^0.2.4",
    "postcss": "^8.5.30",
    "prism-code-editor": "^5.4.0",
    "pyodide": "314.0.7",
    "reka-ui": "^2.11.0",
    "simple-git": "^4.0.2",
    "sqlite-worker": "^0.9.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tailwindcss-animate": "^1.0.7",
    "universal-cookie": "^8.1.2",
    "uuid": "^14.0.3",
    "vite-ssg": "^28.3.0",
    "vite-svg-loader": "^5.1.3",
    "vue": "^3.5.44",
    "vue-router": "^5.4.0",
    "vue-sonner": "^2.0.9"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/bun": "^1.4.3",
    "@types/flexsearch": "^0.7.42",
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^26.6.5",
    "@typescript/native-preview": "^7.0.0-dev.20260707.2",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/tsconfig": "^0.9.1",
    "oxfmt": "^0.73.0",
    "oxlint": "^1.88.0",
    "oxlint-tsgolint": "^7.0.2004",
    "playwright": "^1.64.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5",
    "vue-tsc": "^3.3.13"
  }
}
